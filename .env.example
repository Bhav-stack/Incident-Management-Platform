# Copy to .env and adjust. All values have local-dev defaults.
# Docker Compose reads this file; when running the services with `gradle bootRun`
# export the variables you care about (bootRun does not read .env).

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# PostgreSQL
POSTGRES_DB=aegis                 # incident-svc
POSTGRES_INGEST_DB=aegis_ingest   # ingest-svc (created by postgres-init/)
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Service ports
SIMULATOR_PORT=8080
INGEST_PORT=8081
INCIDENT_PORT=8082

# Control-plane authentication. When set, every /api request on incident-svc
# and simulator must send the same value in the X-API-Key header. Leave it
# empty only for local development and tests: the services then log a warning
# and serve the control plane unauthenticated.
#   curl -H "X-API-Key: $AEGIS_API_KEY" localhost:8082/api/incidents
AEGIS_API_KEY=change-me

# Per-operator credentials. The shared AEGIS_API_KEY above authenticates the
# dashboard client; approval identity comes from these keys instead, and the
# two-person rule for HIGH-risk actions (rollback_deploy, kill_instance) needs
# two of them, because the shared key is deliberately not counted as a person.
# Without them, HIGH-risk proposals are refused with 403 rather than approved by
# a single shared credential.
#   curl -X POST -H "X-Operator-Key: $AEGIS_OPERATOR_1_KEY" \
#     localhost:8082/api/proposals/<id>/approve
AEGIS_OPERATOR_NAME=operator
AEGIS_OPERATOR_1_NAME=oncall-primary
AEGIS_OPERATOR_1_KEY=change-me-primary
AEGIS_OPERATOR_2_NAME=oncall-secondary
AEGIS_OPERATOR_2_KEY=change-me-secondary

# Operator tokens (JWT). An approval is signed by a short-lived token whose
# subject is the operator, so the audit trail names a document rather than a
# shared secret. Either point issuer-uri at a real OIDC provider, in which case
# that provider issues the tokens and they are validated against its published
# keys over OIDC discovery, or set a secret and let the service mint its own:
#   openssl rand -base64 48
#   curl -X POST -H "X-Operator-Key: $AEGIS_OPERATOR_1_KEY" \
#     localhost:8082/api/auth/session      # -> { token, subject, expiresInSeconds }
#   curl -X POST -H "Authorization: Bearer $TOKEN" \
#     localhost:8082/api/proposals/<id>/approve
# With neither set, bearer tokens are refused and only keys authenticate.
AEGIS_OIDC_ISSUER_URI=
AEGIS_OIDC_AUDIENCE=aegis-control-plane
AEGIS_JWT_ISSUER=aegis-control-plane
AEGIS_JWT_SECRET=
AEGIS_JWT_TTL_SECONDS=300

# Live incident feed (STOMP over WebSocket). The dashboard fetches a
# short-lived single-use ticket from POST /api/ws-ticket through its proxy, so
# the API key never reaches the browser. Set to false only to debug a client
# that cannot present a ticket.
AEGIS_WS_REQUIRE_TICKET=true

# Agent layer (Phase 4)
# AGENT_MODE=rule            # rule = deterministic proposer, agent = LLM loop
# AGENT_FAKE_LLM=false       # true = scripted LLM, no API key needed
# OPENAI_API_KEY=

# Observability (Phase 6)
GRAFANA_PASSWORD=admin        # grafana admin login (http://localhost:3000)
