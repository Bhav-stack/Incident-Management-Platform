# Copy to .env and adjust. All values have local-dev defaults.
# Docker Compose reads this file; when running the services with `gradle bootRun`
# export the variables you care about (bootRun does not read .env).

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# PostgreSQL
POSTGRES_DB=aegis                 # incident-svc
POSTGRES_INGEST_DB=aegis_ingest   # ingest-svc (created by postgres-init/)
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Service ports
SIMULATOR_PORT=8080
INGEST_PORT=8081
INCIDENT_PORT=8082

# Control-plane authentication. When set, every /api request on incident-svc
# and simulator must send the same value in the X-API-Key header. Leave it
# empty only for local development and tests: the services then log a warning
# and serve the control plane unauthenticated.
#   curl -H "X-API-Key: $AEGIS_API_KEY" localhost:8082/api/incidents
AEGIS_API_KEY=change-me

# Agent layer (Phase 4)
# AGENT_MODE=rule            # rule = deterministic proposer, agent = LLM loop
# AGENT_FAKE_LLM=false       # true = scripted LLM, no API key needed
# OPENAI_API_KEY=

# Observability (Phase 6)
GRAFANA_PASSWORD=admin        # grafana admin login (http://localhost:3000)
