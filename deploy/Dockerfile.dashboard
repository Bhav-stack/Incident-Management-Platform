# Dashboard: build the static bundle, then serve it from nginx, which also
# reverse-proxies /api and /ws to incident-svc so the browser sees one origin.
FROM node:22-alpine AS build
WORKDIR /src
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci
COPY dashboard/ ./
RUN npm run build

FROM nginx:1.27-alpine
# The nginx entrypoint substitutes ${AEGIS_API_KEY} in files under
# /etc/nginx/templates into /etc/nginx/conf.d at container start.
COPY deploy/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /src/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
