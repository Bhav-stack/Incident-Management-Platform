# Production environment for deploy/compose.prod.yml.
#
#   cp .env.prod.example .env      # then edit every value marked CHANGE ME
#   chmod 600 .env
#
# .env is gitignored. Nothing in this file is a real secret; the generated
# values stay on the host. Generate them with the commands given below rather
# than inventing them, so the length requirements (the JWT secret must be at
# least 32 bytes for HS256) are met by construction.
#
# Every variable that has no default is marked `:?` in compose.prod.yml, so a
# missing value fails the deploy immediately with the variable's name instead of
# starting a service that half-works.

# ---------------------------------------------------------------------------
# Identity of the deployment
# ---------------------------------------------------------------------------

# The public hostname. A free DuckDNS subdomain works and is what DEPLOY.md
# walks through: create one at https://www.duckdns.org, point it at the VM's
# public IP, and Caddy issues a certificate for it on first boot.
SITE_HOST=CHANGE-ME.duckdns.org

# ACME needs a contact address for expiry notices. It is not used for anything
# else, and it is never shown to visitors.
ACME_EMAIL=CHANGE-ME@example.com

# http in local testing, https on the real host.
SITE_SCHEME=https

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------

POSTGRES_DB=aegis
POSTGRES_INGEST_DB=aegis_ingest
POSTGRES_USER=aegis

# CHANGE ME. The Postgres port is not published, so this is defence in depth
# rather than the only lock on the door.
#   openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE-ME

# CHANGE ME. Grafana's admin login: the anonymous visitor role is Viewer, so
# this is what can change dashboards and data sources.
#   openssl rand -base64 24
GRAFANA_PASSWORD=CHANGE-ME

# ---------------------------------------------------------------------------
# Control-plane credentials
# ---------------------------------------------------------------------------

# The shared machine credential: it is what incident-svc presents to the
# simulator, and it is deliberately NOT attributable to a person, so it cannot
# satisfy a two-person approval.
#   openssl rand -base64 32
AEGIS_API_KEY=CHANGE-ME

# The built-in token issuer. The issuer must be an absolute http(s) URL because
# a JWT `iss` claim is a URL, and the secret must be at least 32 bytes.
#   openssl rand -base64 48
AEGIS_JWT_SECRET=CHANGE-ME
AEGIS_JWT_ISSUER=https://CHANGE-ME.duckdns.org/control-plane

# Where the dashboard runs. Vercel gives you this the moment the project is
# created: https://<project>.vercel.app. Comma-separate extra origins (for
# example a custom domain, or a preview deployment you want to test).
#
# A wildcard is not used and should not be: the control plane accepts
# authenticated writes from exactly these origins.
AEGIS_CORS_ORIGINS=https://CHANGE-ME.vercel.app

# ---------------------------------------------------------------------------
# Demo operators
# ---------------------------------------------------------------------------
#
# A HIGH-risk proposal needs two distinct attributable operators, so the demo
# needs two operator keys. On a public demo they are intentionally public: the
# landing page tells a visitor to sign in as each of them and approve in turn,
# which is the whole point of the two-person rule being real rather than
# described. They can approve simulated recoveries on simulated services and
# nothing else.
#
# To make the deployment single-tenant, replace both keys with `openssl rand
# -base64 24` output and stop advertising them.
AEGIS_OPERATOR_1_NAME=demo-oncall-primary
AEGIS_OPERATOR_1_KEY=demo-primary-key

AEGIS_OPERATOR_2_NAME=demo-oncall-secondary
AEGIS_OPERATOR_2_KEY=demo-secondary-key

# Raise or lower the two-person requirement. MEDIUM on the public demo so that a
# normal restart still needs two signatures (the interesting path), while the
# deliberately stubborn scenario keeps exercising rollback.
# POLICY_TWOPERSONLEVELS=MEDIUM

# ---------------------------------------------------------------------------
# Demo traffic
# ---------------------------------------------------------------------------

# The simulator injects a fault on a schedule so a visitor who opens the link at
# an arbitrary moment finds a live incident rather than an empty board.
SIMULATOR_DEMO_ENABLED=true
SIMULATOR_DEMO_INTERVAL_SECONDS=180
SIMULATOR_DEMO_DURATION_SECONDS=90

SIMULATOR_SERVICES=checkout-service,payment-service,search-service

# The free host has 2 vCPU, so the pipeline is deliberately given a smaller
# order buffer than a laptop would use. The measured ceiling on this hardware,
# and how to raise it, are recorded in DEPLOY.md.
INGEST_MAX_QUEUE_SIZE=5000
