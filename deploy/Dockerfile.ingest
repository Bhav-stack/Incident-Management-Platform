FROM eclipse-temurin:21-jdk AS build
WORKDIR /src
COPY gradlew settings.gradle.kts build.gradle.kts ./
COPY gradle ./gradle
COPY contracts ./contracts
COPY ingest-svc ./ingest-svc
RUN ./gradlew :ingest-svc:bootJar --no-daemon

FROM eclipse-temurin:21-jre
RUN useradd --system --uid 10001 --create-home aegis
WORKDIR /app
COPY --from=build --chown=aegis:aegis \
     /src/ingest-svc/build/libs/ingest-svc-0.1.0-SNAPSHOT.jar /app/app.jar
USER aegis
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
