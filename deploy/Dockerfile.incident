FROM eclipse-temurin:21-jdk AS build
WORKDIR /src
COPY gradlew settings.gradle.kts build.gradle.kts ./
COPY gradle ./gradle
COPY contracts ./contracts
COPY incident-svc ./incident-svc
RUN ./gradlew :incident-svc:bootJar --no-daemon

FROM eclipse-temurin:21-jre
# Never run the control plane as root.
#
# curl is not in this base image, and without a client in the image a Compose
# healthcheck has nothing to run: the service would be reported healthy the
# moment the container started, and every downstream service would begin
# against a port nobody is listening on yet. It doubles as the debugging tool
# an operator reaches for first inside a container.
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --create-home aegis
WORKDIR /app
COPY --from=build --chown=aegis:aegis \
     /src/incident-svc/build/libs/incident-svc-0.1.0-SNAPSHOT.jar /app/app.jar
USER aegis
EXPOSE 8082
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
